obj_id: CopyofRetailSalesWS-LocalJoins
model:
  name: Copy of Retail Sales WS - Local Joins
  description: The Retail Sales WS worksheet provides a comprehensive overview of transactions, capturing details about the products sold, including their names, types, and prices, along with the quantity purchased. It also includes geographical information such as city, county, state, region, and specific store locations, represented by store names and zip codes. Additionally, the worksheet records the sales amount, sales date, and applicable sales tax percentage, along with a unique identifier for each transaction. (AI generated)
  model_tables:
  - name: DIM_RETAPP_PRODUCTS
    obj_id: DIM_RETAPP_PRODUCTS-fe481140
  - name: FACT_RETAPP_SALES
    joins:
    - with: DIM_RETAPP_PRODUCTS
      'on': '[FACT_RETAPP_SALES::Product ID] = [DIM_RETAPP_PRODUCTS::Product ID]'
      type: INNER
      cardinality: MANY_TO_ONE
    - with: DIM_RETAPP_STORES
      'on': '[FACT_RETAPP_SALES::Store ID] = [DIM_RETAPP_STORES::Store ID]'
      type: INNER
      cardinality: MANY_TO_ONE
    obj_id: FACT_RETAPP_SALES-0908b1bf
  - name: DIM_RETAPP_STORES
    obj_id: DIM_RETAPP_STORES-41e4d630
  formulas:
  - id: formula_Sales Tax (8%)
    name: Sales Tax (8%)
    expr: '[FACT_RETAPP_SALES::Sales Amount] * [Sales Tax Rate] / 100'
  columns:
  - name: Product Name
    column_id: DIM_RETAPP_PRODUCTS::Product Name
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Sales Tax Percentage
    formula_id: formula_Sales Tax (8%)
    properties:
      column_type: MEASURE
      aggregation: AVERAGE
      index_type: DONT_INDEX
      synonyms:
      - sale tax pct
      currency_type:
        iso_code: USD
      synonym_type: USER_DEFINED
  - name: Product Type
    column_id: DIM_RETAPP_PRODUCTS::Product Type
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Store Name
    column_id: DIM_RETAPP_STORES::Store Name
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: City
    column_id: DIM_RETAPP_STORES::City
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: State
    column_id: DIM_RETAPP_STORES::State
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      geo_config:
        region_name:
          country: UNITED STATES
          region_name: state
  - name: Zip Code
    column_id: DIM_RETAPP_STORES::Zip Code
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      geo_config:
        region_name:
          country: UNITED STATES
          region_name: zip code
  - name: County
    column_id: DIM_RETAPP_STORES::County
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      geo_config:
        region_name:
          country: UNITED STATES
          region_name: county
  - name: Lat
    column_id: DIM_RETAPP_STORES::Latitude
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Lon
    column_id: DIM_RETAPP_STORES::Longitude
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Region
    column_id: DIM_RETAPP_STORES::Region
    properties:
      column_type: ATTRIBUTE
  - name: Quantity Purchased
    column_id: FACT_RETAPP_SALES::Quantity Purchased
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Item Price
    column_id: FACT_RETAPP_SALES::Item Price
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      currency_type:
        iso_code: USD
  - name: Sales Amount
    column_id: FACT_RETAPP_SALES::Sales Amount
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - revenue
      - sales
      currency_type:
        iso_code: USD
      synonym_type: USER_DEFINED
  - name: Sales Date
    column_id: FACT_RETAPP_SALES::Sales Date
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  properties:
    is_bypass_rls: false
    join_progressive: true
    spotter_config:
      is_spotter_enabled: true
  parameters:
  - id: ca005553-8585-4ca2-97aa-20f478a7cbe9
    name: Data Security PARAM
    data_type: CHAR
    default_value: Secured
    description: ''
  - id: bdc94a57-7eee-43a2-8b04-21015b999255
    name: Sales Tax Rate
    data_type: DOUBLE
    default_value: '0.0'
