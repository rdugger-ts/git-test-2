obj_id: SalesPerformanceDashboard-2779b117
liveboard:
  name: Sales Performance Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: 4f9e90e6-aedb-4e2d-abc0-71d2e311f1b8
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center; color: #1f4e79; margin: 20px 0;\"><span style=\"white-space: pre-wrap;\">📊 Sales Performance Dashboard</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"padding: 15px; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); border-radius: 8px; margin: 10px 0;\"><span style=\"white-space: pre-wrap; color: #2c3e50; line-height: 1.6;\">🔍 <strong>Analysis Summary:</strong><br><tab>This comprehensive sales performance dashboard provides key insights into revenue trends and store performance across our retail network. The analysis includes:<br><br>📈 <strong>Time Series KPIs:</strong><br><tab>• Monthly sales trends showing revenue ranging from $13.4M to $24.8M per month<br><tab>• Month-over-month growth analysis revealing seasonal patterns and performance fluctuations<br><br>🏪 <strong>Store Performance Insights:</strong><br><tab>• Top performing stores led by Nevada (89145) Las Vegas with $67.3M in total sales<br><tab>• Geographic distribution across 30 store locations spanning multiple states<br><tab>• Performance comparison revealing significant variation between locations<br><br>💡 <strong>Key Findings:</strong><br><tab>Nevada and Montana stores dominate the top 5 performers, with the top store generating over 2x the revenue of median performers.<br><br><span style=\"color: #7f8c8d; font-size: 0.9em;\">Generated on March 26, 2026 at 20:29 UTC</span></span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: Show total sales by month as a time series KPI.
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "[sales] [date].monthly"
      answer_columns:
      - name: Month(date)
      - name: Total sales
      table:
        table_columns:
        - column_id: Month(date)
          headline_aggregation: MIN-MAX
        - column_id: Total sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Month(date)
        - Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: KPI
        chart_columns:
        - column_id: Month(date)
        - column_id: Total sales
        axis_configs:
        - x:
          - Month(date)
          "y":
          - Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total sales\",\"columnProperty\": {}},{\"columnId\": \"Month(date)\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"cf2d2070-7282-4c7e-a132-fab19af539c5\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"e7b25599-ea98-40ad-9003-bc55475c57c9\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Month(date)\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: 0fe24b6a-b417-4000-a79b-20d5c7f1a9f1
  - id: Viz_3
