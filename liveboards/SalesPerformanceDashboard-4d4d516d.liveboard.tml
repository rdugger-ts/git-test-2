obj_id: SalesPerformanceDashboard-4d4d516d
liveboard:
  name: Sales Performance Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: 0c599926-4cfe-409c-9128-2243d3570b20
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center; color: #1F4E79; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">📊 Sales Performance Analytics Dashboard</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"padding: 15px; background-color: #f8f9fa; border-radius: 8px; line-height: 1.6;\"><span style=\"white-space: pre-wrap; color: #333;\">🕒 <strong>Generated on March 26, 2026 22:38 UTC</strong><br><br>📈 <strong style=\"color: #28a745;\">Key Performance Insights:</strong><br>• Two comprehensive time series KPIs tracking monthly sales performance across all stores and by region<br>• Regional performance breakdown showing West and East regions as top performers with $67M+ and $60M+ respectively<br>• Store ranking analysis reveals Nevada (89145) as the #1 performing store with $67.3M in total sales<br>• Complete store performance metrics within each region for strategic decision making<br><br>🎯 <strong style=\"color: #17a2b8;\">Analysis Coverage:</strong><br>• Monthly sales trends from 2020-2026 across all regions<br>• Regional sales distribution: West, East, Midwest, Southwest, and South<br>• Individual store performance rankings within regional context<br>• Total sales aggregations for comprehensive business insights</span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: Show total sales as a time series KPI (monthly) for all stores.
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "[sales] [date].monthly [store]"
      answer_columns:
      - name: Month(date)
      - name: Total sales
      - name: store
      table:
        table_columns:
        - column_id: Month(date)
          headline_aggregation: MIN-MAX
        - column_id: Total sales
          headline_aggregation: SUM
        - column_id: store
          headline_aggregation: COUNT_DISTINCT
        ordered_column_ids:
        - Month(date)
        - store
        - Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"store\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: KPI
        chart_columns:
        - column_id: Month(date)
        - column_id: Total sales
        - column_id: store
        axis_configs:
        - x:
          - Month(date)
          "y":
          - Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total sales\",\"columnProperty\": {}},{\"columnId\": \"store\",\"columnProperty\": {}},{\"columnId\": \"Month(date)\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"24b03785-7da3-419b-a45d-ead88af48fda\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"01a4f5df-8be6-4bda-b385-ac673d11d454\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Month(date)\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: 70d2f7b1-fcde-4e8b-8701-8f6849698742
