        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"region\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}},{\"columnId\": \"store\",\"columnProperty\": {}},{\"columnId\": \"store rank within region\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"106fcec2-84c7-4e76-b812-ed2fac97f132\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"f673264e-e7c3-4b09-9f8e-c203890333db\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"store\"]}}]}"
