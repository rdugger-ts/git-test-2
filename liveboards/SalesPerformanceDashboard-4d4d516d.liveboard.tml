  - id: Viz_5
    answer:
      name: How do stores rank within each region based on total sales?
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      formulas:
      - id: formula_store rank within region
        name: store rank within region
        expr: "rank ( [formula_store sales] , 'desc' )"
        was_auto_generated: false
      - id: formula_store sales
        name: store sales
        expr: "group_aggregate ( sum ( [sales] ) , query_groups ( ) , query_filters ( ) )"
        was_auto_generated: false
      search_query: "[sales] [formula_store rank within region] [region] [store]"
      answer_columns:
      - name: Total sales
      - name: region
      - name: store
      - name: store rank within region
      table:
        table_columns:
        - column_id: Total sales
          headline_aggregation: SUM
        - column_id: region
          headline_aggregation: COUNT_DISTINCT
        - column_id: store
          headline_aggregation: COUNT_DISTINCT
        - column_id: store rank within region
          headline_aggregation: COUNT_DISTINCT
        ordered_column_ids:
        - region
        - store
        - store rank within region
        - Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"region\",\"columnProperty\": {}},{\"columnId\": \"store\",\"columnProperty\": {}},{\"columnId\": \"store rank within region\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: COLUMN
        chart_columns:
        - column_id: Total sales
        - column_id: region
        - column_id: store
        - column_id: store rank within region
        axis_configs:
