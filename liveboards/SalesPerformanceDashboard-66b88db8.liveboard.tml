  visualizations:
  - id: Viz_1
    viz_guid: 0e5059bd-fc9b-42d6-8dd8-a24b0aae7154
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center; color: #1A73E8; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">📊 Sales Performance Dashboard</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); padding: 20px; border-radius: 10px; margin: 15px 0; line-height: 1.6;\"><span style=\"white-space: pre-wrap; color: #333;\"><strong style=\"color: #1A73E8;\">📅 Generated on March 27, 2026 12:33 UTC</strong><br><br>🎯 <strong style=\"color: #34A853;\">Dashboard Overview:</strong><br>This comprehensive sales performance dashboard provides critical insights into your business performance across multiple dimensions and timeframes.<br><br>📈 <strong style=\"color: #EA4335;\">Key Performance Indicators:</strong><br>• Month-over-Month (MoM) Sales Growth by Region<br>• Year-over-Year (YoY) Sales Growth Trends<br>• Regional Sales Performance Analysis<br>• Store-Level Performance Metrics<br><br>🌟 <strong style=\"color: #FBBC04;\">Key Insights:</strong><br>• Strong double-digit YoY growth in 2021 (9.6-10.2% across regions)<br>• Stabilization in 2022-2023 with growth rates around 0.1-1.1%<br>• Recent performance challenges in 2024-2026 with some negative growth<br>• Regional variations showing East and West leading in total sales volume<br><br>🎯 <strong style=\"color: #9C27B0;\">Use Cases:</strong><br>Monitor sales trends, identify growth opportunities, track regional performance, and make data-driven business decisions.</span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: Show month-over-month (MoM) sales growth for each region.
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "growth of [sales] by [date] [date].monthly [region]"
      answer_columns:
      - name: Growth of Total sales
      - name: Month(date)
      - name: region
      table:
        table_columns:
        - column_id: Growth of Total sales
          headline_aggregation: MIN
        - column_id: Month(date)
          headline_aggregation: MIN-MAX
        - column_id: region
          headline_aggregation: COUNT_DISTINCT
        ordered_column_ids:
        - region
        - Month(date)
        - Growth of Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"region\",\"columnProperty\": {}},{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Growth of Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: KPI
        chart_columns:
        - column_id: Growth of Total sales
        - column_id: Month(date)
        - column_id: region
        axis_configs:
        - x:
          - Month(date)
          "y":
          - Growth of Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"},\"kpiDisplayProperties\": {\"showChange\": true,\"showChangeAs\": \"PERCENT\",\"changeInterpretation\": \"UPWARD_IS_GOOD\"}},\"columnProperties\": [{\"columnId\": \"region\",\"columnProperty\": {\"kpiColumnProperties\": {\"showAbbreviatedPreviousDate\": false,\"showSparkline\": true,\"showComparisonDate\": true,\"showCurrentDateLabel\": true,\"showPreviousDateLabel\": true,\"showPreviousValue\": true}}},{\"columnId\": \"Month(date)\",\"columnProperty\": {\"kpiColumnProperties\": {\"showAbbreviatedPreviousDate\": false,\"showSparkline\": true,\"showComparisonDate\": true,\"showCurrentDateLabel\": true,\"showPreviousDateLabel\": true,\"showPreviousValue\": true}}},{\"columnId\": \"Growth of Total sales\",\"columnProperty\": {\"kpiColumnProperties\": {\"showAbbreviatedPreviousDate\": false,\"showSparkline\": true,\"showComparisonDate\": true,\"showCurrentDateLabel\": true,\"showPreviousDateLabel\": true,\"showPreviousValue\": true}}}],\"axisProperties\": [{\"id\": \"f817782f-84de-498f-853f-692145bf9592\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Growth of Total sales\"],\"isOpposite\": false}},{\"id\": \"b6403e80-e03a-420a-945e-0e38effe6ed5\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Month(date)\"]}}],\"systemSeriesColors\": [{\"serieName\": \"Growth of Total sales\",\"color\": \"#2E75F0\"}]}"
      display_mode: CHART_MODE
