obj_id: SalesPerformanceDashboard-8ee295df
liveboard:
  name: Sales Performance Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: c212a5cc-8f2f-40e9-a7f9-bd6ef17671bf
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center; color: #2E5E99; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">📊 Sales Performance Analysis Dashboard</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"text-align: center; font-size: 12px; color: #666; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">Generated on March 27, 2026 12:29 UTC</span></p><div style=\"background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); padding: 20px; border-radius: 10px; margin: 15px 0;\"><h3 style=\"color: #2E5E99; margin-bottom: 15px;\">🔍 Executive Summary</h3><p style=\"margin-bottom: 10px; line-height: 1.6;\"><strong>📈 Time Series KPIs:</strong><br>• Month-over-Month growth shows volatility with peaks in Jul-Aug 2024/2025 (~10-12% growth)<br>• Year-over-Year trends indicate recovery patterns with regional variations</p><p style=\"margin-bottom: 10px; line-height: 1.6;\"><strong>🌍 Regional Performance:</strong><br>• <span style=\"color: #28a745;\">Midwest leads</span> with $107.3M (highest performer)<br>• <span style=\"color: #007bff;\">East follows</span> with $94.3M<br>• <span style=\"color: #ffc107;\">West generates</span> $89.8M<br>• Southwest and South show opportunities for growth at $55.8M and $19.6M respectively</p><p style=\"line-height: 1.6;\"><strong>🏪 Store Insights:</strong><br>• Top performing stores include Colorado (80301) at $16.3M and Illinois (60642) at $15.3M<br>• Geographic distribution shows strong performance across multiple states<br>• Store performance ranges from $8.3M to $16.3M indicating consistent market presence</p></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: Show month over month sales growth for the last two years.
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "growth of [sales] by [date] [date].monthly [date] = 'last 2 years'"
      answer_columns:
      - name: Growth of Total sales
      - name: Month(date)
      table:
        table_columns:
        - column_id: Growth of Total sales
          headline_aggregation: MIN
        - column_id: Month(date)
          headline_aggregation: MIN-MAX
        ordered_column_ids:
        - Month(date)
        - Growth of Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Growth of Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: LINE
        chart_columns:
        - column_id: Growth of Total sales
        - column_id: Month(date)
        axis_configs:
        - x:
          - Month(date)
          "y":
          - Growth of Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Growth of Total sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"0eafc606-c206-48d1-97a5-4b3b9a24f75d\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Growth of Total sales\"],\"isOpposite\": false}},{\"id\": \"7e695a15-e7e5-4501-879f-ce940a43e7a6\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Month(date)\"]}}]}"
      display_mode: CHART_MODE
