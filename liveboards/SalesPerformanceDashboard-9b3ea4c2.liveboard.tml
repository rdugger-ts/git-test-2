  visualizations:
  - id: Viz_1
    viz_guid: 7766add2-c5f2-4c11-ba84-fa7ffbcb067c
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center; color: #2E86AB; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">📊 Sales Performance Analysis Dashboard</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"font-size: 12px; color: #666; text-align: center; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">Generated on March 26, 2026 at 22:27 UTC</span></p><div style=\"background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); padding: 20px; border-radius: 8px; margin: 10px 0;\"><h3 style=\"color: #2E86AB; margin-bottom: 15px;\">📈 Key Performance Insights</h3><p style=\"margin-bottom: 10px; line-height: 1.6;\"><strong style=\"color: #E63946;\">Sales Trend:</strong> Monthly sales showing strong performance with peak months in 2023 reaching $24.8M, indicating seasonal patterns and growth opportunities.</p><p style=\"margin-bottom: 10px; line-height: 1.6;\"><strong style=\"color: #F77F00;\">Store Performance:</strong> Top performing stores by quantity include Nevada locations (89145: 1.28M units, 89052: 1.19M units) and Montana stores (59718: 1.2M units, 59106: 1.19M units).</p><p style=\"margin-bottom: 10px; line-height: 1.6;\"><strong style=\"color: #06FFA5;\">Time Series Analysis:</strong> Sales data spans from 2020 to 2026, showing recovery and growth patterns with consistent monthly performance tracking.</p><p style=\"line-height: 1.6;\"><strong style=\"color: #7209B7;\">Geographic Insights:</strong> Store-level analysis reveals regional performance variations, enabling targeted optimization strategies and resource allocation decisions.</p></div><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: Show total sales as a time series KPI.
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "[sales] [date].monthly"
      answer_columns:
      - name: Month(date)
      - name: Total sales
      table:
        table_columns:
        - column_id: Month(date)
          headline_aggregation: MIN-MAX
        - column_id: Total sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Month(date)
        - Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: KPI
        chart_columns:
        - column_id: Month(date)
        - column_id: Total sales
        axis_configs:
        - x:
          - Month(date)
          "y":
          - Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"60000a21-d356-4676-af12-35780de4247f\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"86b0a26c-870d-4a1c-8d3f-1988b2a0bfb8\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Month(date)\"]}}]}"
      display_mode: CHART_MODE
