obj_id: SalesPerformanceDashboard-b88fe1b6
liveboard:
  name: Sales Performance Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: 89b90a5b-4aa5-4974-8d16-583ff1db5e75
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center; color: #1e3a8a; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">📊 Sales Performance Analysis Dashboard</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); padding: 20px; border-radius: 10px; margin: 15px 0;\"><span style=\"white-space: pre-wrap; color: #1e40af; font-size: 14px; line-height: 1.6;\"><strong>📅 Generated on March 26, 2026 at 20:36 UTC</strong><br><br>🎯 <strong>Executive Summary:</strong><br>This comprehensive sales performance dashboard provides critical insights into retail operations with both temporal trends and store-level analysis.<br><br>📈 <strong>Time Series KPI Analysis:</strong><br>• <strong>Monthly Sales Trends:</strong> Peak performance observed in 2023 with monthly sales reaching $24.8M in July, showing strong seasonal patterns<br>• <strong>Quantity Trends:</strong> Consistent purchase volumes with highest activity in 2023 (475K+ units in July)<br>• <strong>Growth Pattern:</strong> Clear seasonal cycles with notable peaks in mid-2023 period<br><br>🏪 <strong>Store Performance Insights:</strong><br>• <strong>Top Performing Stores:</strong> Nevada (89145) leads with $67.3M in sales and 1.28M units sold<br>• <strong>Geographic Distribution:</strong> Strong performance across multiple states with Montana and Nevada showing exceptional results<br>• <strong>Performance Range:</strong> Significant variance from $17.5M to $67.3M across store locations<br><br>💡 <strong>Key Actionable Insights:</strong><br>✓ Focus on replicating success factors from top-performing Nevada and Montana locations<br>✓ Investigate seasonal trends to optimize inventory and staffing during peak periods<br>✓ Analyze underperforming stores for improvement opportunities</span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: "Show total sales as a time series KPI (e.g., monthly trend)."
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "[sales] [date].monthly"
      answer_columns:
      - name: Month(date)
      - name: Total sales
      table:
        table_columns:
        - column_id: Month(date)
          headline_aggregation: MIN-MAX
        - column_id: Total sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Month(date)
        - Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: KPI
        chart_columns:
        - column_id: Month(date)
        - column_id: Total sales
        axis_configs:
        - x:
          - Month(date)
          "y":
          - Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"1c6f5d5c-59c2-494a-bfcb-56d385e44ce0\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"8a3f79be-acc1-4cae-9ec1-855cf54bd72f\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Month(date)\"]}}]}"
