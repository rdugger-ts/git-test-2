obj_id: SalesPerformanceDashboard-233b3de4
liveboard:
  name: Sales Performance Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: 81867a6b-cde5-4bfe-9a78-ca681092240b
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center; color: #1a365d; margin-bottom: 20px;\"><span style=\"white-space: pre-wrap;\">📊 Sales Performance Dashboard Analysis</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"padding: 15px; background-color: #f7fafc; border-left: 4px solid #3182ce; margin: 10px 0;\"><span style=\"white-space: pre-wrap; color: #2d3748; line-height: 1.6;\">🚀 <strong style=\"color: #1a365d;\">Comprehensive Sales Performance Overview</strong><br><br>This dashboard provides a complete view of our retail apparel sales performance across multiple dimensions:<br><br>⏰ <strong style=\"color: #3182ce;\">Time Series KPIs:</strong><br>• Monthly total sales trends showing performance over time from 2020-2026<br>• Quantity purchased patterns indicating demand fluctuations<br><br>🏪 <strong style=\"color: #3182ce;\">Store Performance Analytics:</strong><br>• Individual store sales performance with geographic insights<br>• Regional sales distribution across Midwest, South, West, East, and Southwest<br><br>📈 <strong style=\"color: #3182ce;\">Key Insights:</strong><br>• Peak sales periods identified in 2023 (reaching $24M+ monthly)<br>• West region leading with $335M+ in total sales<br>• Nevada and Montana stores showing exceptional performance<br><br>Generated on March 26, 2026 at 20:31 UTC</span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: "Show total sales as a time series KPI (e.g., monthly or yearly)."
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "[sales] [date].monthly"
      answer_columns:
      - name: Month(date)
      - name: Total sales
      table:
        table_columns:
        - column_id: Month(date)
          headline_aggregation: MIN-MAX
        - column_id: Total sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Month(date)
        - Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Month(date)\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: KPI
        chart_columns:
        - column_id: Month(date)
        - column_id: Total sales
        axis_configs:
        - x:
          - Month(date)
          "y":
          - Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total sales\",\"columnProperty\": {}},{\"columnId\": \"Month(date)\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"cb354efe-7eec-467d-b267-f1272fa9ad84\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"c080a2d3-900d-43e0-b8ae-72d29dd0e3ef\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Month(date)\"]}}]}"
      display_mode: CHART_MODE
    viz_guid: e954f42a-43b9-4f20-83a4-6a436cdf9aaa
