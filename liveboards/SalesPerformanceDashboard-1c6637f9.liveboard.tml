obj_id: SalesPerformanceDashboard-1c6637f9
liveboard:
  name: Sales Performance Dashboard
  visualizations:
  - id: Viz_1
    viz_guid: aa844c7d-9495-4741-ae5f-bb5d8257d1e9
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\" dir=\"ltr\" style=\"text-align: center;\"><span style=\"white-space: pre-wrap;\">📊 Sales Performance Dashboard</span></h2><p class=\"theme-module__editor-paragraph\" dir=\"ltr\" style=\"margin: 15px; line-height: 1.6;\"><span style=\"white-space: pre-wrap; color: #2c3e50;\"><strong>📈 Analysis Summary:</strong><br><br>This dashboard provides comprehensive insights into sales performance across time series KPIs and regional store metrics:<br><br>🕐 <strong>Time Series KPIs:</strong><br>• Daily sales trends showing consistent performance around $800K daily<br>• Regional sales evolution over time with West region leading performance<br><br>🏪 <strong>Regional Store Performance:</strong><br>• West region dominates with $335.9M in total sales<br>• Midwest ($224.7M), East ($252.4M), Southwest ($116.7M), and South ($41M) follow<br>• Top performing stores include Montana (59718) at $62.9M and Nevada locations<br><br>💡 <strong>Key Insights:</strong><br>• West region consistently outperforms other regions<br>• Store performance varies significantly within regions<br>• Sales trends show seasonal patterns and growth opportunities<br><br><em style=\"font-size: 0.9em; color: #7f8c8d;\">Generated on March 26, 2026 22:41 UTC</em></span></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\"></div>"
  - id: Viz_2
    answer:
      name: Show total sales over time as a time series.
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        obj_id: SampleRetail-Apparel-cd252e5c
      search_query: "[sales] [date].daily"
      answer_columns:
      - name: Day(date)
      - name: Total sales
      table:
        table_columns:
        - column_id: Day(date)
          headline_aggregation: MIN-MAX
        - column_id: Total sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Day(date)
        - Total sales
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Day(date)\",\"columnProperty\": {}},{\"columnId\": \"Total sales\",\"columnProperty\": {}}]}"
      chart:
        type: LINE
        chart_columns:
        - column_id: Day(date)
        - column_id: Total sales
        axis_configs:
        - x:
          - Day(date)
          "y":
          - Total sales
        client_state: ""
        client_state_v2: "{\"version\": \"V4DOT2\",\"chartProperties\": {\"gridLines\": {},\"responsiveLayoutPreference\": \"USER_PREFERRED_ON\",\"chartSpecific\": {\"dataFieldArea\": \"column\"}},\"columnProperties\": [{\"columnId\": \"Total sales\",\"columnProperty\": {}},{\"columnId\": \"Day(date)\",\"columnProperty\": {}}],\"axisProperties\": [{\"id\": \"9951e28a-c05c-459d-bfa7-2f56b24975a4\",\"properties\": {\"axisType\": \"Y\",\"linkedColumns\": [\"Total sales\"],\"isOpposite\": false}},{\"id\": \"43d097af-1853-4f15-aa5e-b66bb7cfc4e8\",\"properties\": {\"axisType\": \"X\",\"linkedColumns\": [\"Day(date)\"]}}]}"
      display_mode: CHART_MODE
